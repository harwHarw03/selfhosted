# Homepage accepts requests only for these Host headers. Replace the example
# tailnet hostname after running `tailscale serve status` on the Main VM.
HOMEPAGE_ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000,homepage.your-tailnet.ts.net:8443

# Browser-facing links. Tailscale Serve URLs work from enrolled phones.
HOMEPAGE_VAR_FILEBROWSER_URL=https://harwnas.your-tailnet.ts.net:8443
HOMEPAGE_VAR_PHOTOPRISM_URL=https://harwnas.your-tailnet.ts.net:9443
