# Immich v3 requires an x86-64-v2 capable CPU for machine learning.
IMMICH_VERSION=v3.0.3
TZ=UTC

# NFS-backed asset storage. Do not manually edit UPLOAD_LOCATION.
UPLOAD_LOCATION=/mnt/storage/media/immich

# Read-only files copied and organized manually through the storage share.
EXTERNAL_LIBRARY_LOCATION=/mnt/storage/media/personal

# PostgreSQL must remain on the VM's local Linux filesystem, never NFS.
DB_DATA_LOCATION=/opt/homelab/data/immich/postgres
DB_STORAGE_TYPE=HDD
DB_PASSWORD=replace_with_random_alphanumeric_password
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
